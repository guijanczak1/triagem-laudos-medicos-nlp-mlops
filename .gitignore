# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.eggs/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Dataset artifacts (reproducible via script) - keep only the license note
data/processed/
data/raw/*
!data/raw/LICENSE_DATASET.md

# Model artifacts (regenerated by training/export)
models/

# Environment / secrets
.env
.env.*
!.env.example

# Terraform - local state and binaries only; the lock file IS versioned
deploy/**/.terraform/
deploy/**/*.tfstate
deploy/**/*.tfstate.*
deploy/**/.terraform.tfstate.lock.info

# Airflow (local execution)
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
