# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.eggs/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Dataset artifacts (reproducible via script) - keep only the license note
# Anchored to repo root (/) - unanchored patterns match any nested dir with
# the same name, which would also hide src/triagem/data/ (real source code).
/data/processed/
/data/raw/*
!/data/raw/LICENSE_DATASET.md

# Model artifacts (regenerated by training/export)
# Anchored to repo root - unanchored "models/" also matched src/triagem/models/
# and tests/models/ (real source code), silently hiding them from git.
/models/

# Environment / secrets
.env
.env.*
!.env.example

# Terraform - local state and binaries only; the lock file IS versioned
deploy/**/.terraform/
deploy/**/*.tfstate
deploy/**/*.tfstate.*
deploy/**/.terraform.tfstate.lock.info
deploy/**/tfplan.out
deploy/**/terraform.tfvars

# Airflow (local execution)
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
