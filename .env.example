# Copy this file to .env and fill in values as needed.
# All keys start empty on purpose - safe defaults live in code (src/triagem/config.py).
# Never commit a .env file with real values.
# All keys are prefixed with TRIAGEM_ (see Settings in src/triagem/config.py).

TRIAGEM_DATA_DIR=
TRIAGEM_RAW_DIR=
TRIAGEM_PROCESSED_DIR=
TRIAGEM_MODELS_DIR=
TRIAGEM_DATA_PATH=
TRIAGEM_MODEL_BACKEND=
TRIAGEM_SEED=
TRIAGEM_API_PORT=
TRIAGEM_LOG_LEVEL=
TRIAGEM_DATASET_BASE_URL=

# Grafana admin credentials (docker-compose.yml, T18). Empty here on purpose;
# compose falls back to a local-only default (admin/admin) when unset -- see
# docker-compose.yml's GF_SECURITY_ADMIN_* env vars. Never put a real
# password in this file; override via a local (gitignored) .env instead.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Airflow admin credentials (docker-compose.yml, profile "airflow", T15).
# Same pattern as Grafana above: empty here, compose falls back to a
# local-only default (admin/admin) via _AIRFLOW_WWW_USER_USERNAME/PASSWORD.
# Never put a real password in this file; override via a local (gitignored)
# .env instead.
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
